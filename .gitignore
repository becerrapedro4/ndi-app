# Android / Gradle
.gradle/
build/
local.properties
*.iml
.idea/
captures/
.externalNativeBuild/
.cxx/

# Firmas y secretos (nunca al repositorio)
*.jks
*.keystore
keystore.properties
play-service-account.json
*.env

# NDI SDK: la biblioteca libndi.so es propietaria y no se versiona.
# Las cabeceras Processing.NDI.*.h son MIT y si se versionan (las compila CI).
android/app/src/main/jniLibs/*/libndi.so
android/app/src/main/cpp/ndi-sdk/*
!android/app/src/main/cpp/ndi-sdk/include/
!android/app/src/main/cpp/ndi-sdk/include/*.h
!android/app/src/main/cpp/ndi-sdk/README.md

# APKs generados: se publican como release, no en el historial
dist/
web/download/*.apk

# Web
node_modules/

# Caché de Kotlin
.kotlin/
